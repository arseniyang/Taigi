@model IEnumerable<Order>

@{
    ViewData["Title"] = "Управление заказами";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="page-title">Управление заказами</h2>
    </div>

    <!-- Фильтр по статусу -->
    <div class="mb-4">
        <span class="text-muted small me-2">Фильтр по статусу:</span>
        <div class="btn-group" role="group">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm @(ViewBag.CurrentStatus == null ? "active" : "")">Все</a>
            @foreach (var status in ViewBag.Statuses)
            {
                <a asp-action="Index" asp-route-status="@status"
                   class="btn btn-outline-secondary btn-sm @(ViewBag.CurrentStatus == status ? "active" : "")">
                    @OrderStatus.GetRussianName(status)
                </a>
            }
        </div>
    </div>

    <!-- Таблица заказов -->
    <div class="table-responsive">
        <table class="table table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Пользователь</th>
                    <th>Дата</th>
                    <th>Сумма</th>
                    <th>Статус</th>
                    <th>Товаров</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">Заказов не найдено</td>
                    </tr>
                }
                else
                {
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td class="fw-semibold">#@order.Id</td>
                            <td>@order.User?.Email ?? "Неизвестно"</td>
                            <td>@order.OrderDate.ToString("dd.MM.yyyy HH:mm")</td>
                            <td class="fw-bold">@order.TotalAmount.ToString("N0") ₽</td>
                            <td>
                                <span class="badge @(order.Status == "Pending" ? "bg-warning" :
                                                                                        order.Status == "Processing" ? "bg-info" :
                                                                                        order.Status == "Shipped" ? "bg-primary" :
                                                                                        order.Status == "Delivered" ? "bg-success" :
                                                                                        "bg-danger")">
                                    @OrderStatus.GetRussianName(order.Status)
                                </span>
                            </td>
                            <td>@order.OrderItems.Count</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-dark btn-sm rounded-pill px-3">
                                    Детали →
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    .page-title {
        font-size: 24px;
        font-weight: 700;
        color: #1a1a1a;
        letter-spacing: 0.5px;
    }

    .btn-outline-secondary {
        font-size: 12px;
        border-color: #ddd;
        color: #333;
        border-radius: 50px;
        padding: 4px 16px;
        transition: all 0.2s ease;
    }

        .btn-outline-secondary:hover,
        .btn-outline-secondary.active {
            background-color: #1a1a1a;
            color: #fff;
            border-color: #1a1a1a;
        }

    .btn-dark {
        background-color: #1a1a1a;
        border: none;
        font-size: 12px;
        transition: background 0.2s;
        padding: 4px 16px;
    }

        .btn-dark:hover {
            background-color: #333;
        }

    .table {
        font-size: 14px;
    }

        .table thead th {
            font-weight: 600;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #fff;
            padding: 12px 16px;
        }

        .table tbody td {
            padding: 12px 16px;
            vertical-align: middle;
        }

    .table-hover tbody tr:hover {
        background-color: #f8f7f5;
    }

    .badge {
        font-size: 12px;
        font-weight: 500;
        padding: 4px 14px;
        border-radius: 50px;
    }

        .badge.bg-warning {
            background-color: #f59e0b !important;
            color: #fff;
        }

        .badge.bg-info {
            background-color: #3b82f6 !important;
            color: #fff;
        }

        .badge.bg-primary {
            background-color: #8b5cf6 !important;
            color: #fff;
        }

        .badge.bg-success {
            background-color: #22c55e !important;
            color: #fff;
        }

        .badge.bg-danger {
            background-color: #ef4444 !important;
            color: #fff;
        }

    @@media (max-width: 768px) {
        .table {
            font-size: 12px;
        }

            .table thead th,
            .table tbody td {
                padding: 8px 10px;
            }

        .btn-outline-secondary {
            font-size: 10px;
            padding: 2px 10px;
        }

        .btn-dark {
            font-size: 10px;
            padding: 2px 10px;
        }

        .badge {
            font-size: 10px;
            padding: 2px 10px;
        }
    }
</style>