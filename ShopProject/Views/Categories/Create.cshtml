@model Category

@{
    ViewData["Title"] = "Добавить категорию";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-white">
                    <h2 class="card-title">Добавить категорию</h2>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">Название <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Описание</label>
                            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-dark px-4">Сохранить</button>
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">Отмена</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        border: 1px solid #e8e7e4;
        border-radius: 0;
    }

    .card-header {
        border-bottom: 1px solid #e8e7e4;
        padding: 16px 24px;
    }

    .card-title {
        font-size: 20px;
        font-weight: 700;
        color: #1a1a1a;
        margin: 0;
    }

    .card-body {
        padding: 24px;
    }

    .form-label {
        font-weight: 500;
        font-size: 14px;
        color: #555;
        margin-bottom: 4px;
    }

    .form-control {
        border-radius: 0;
        border-color: #e0dedb;
        padding: 10px 14px;
        font-size: 14px;
        transition: border-color 0.2s;
    }

        .form-control:focus {
            border-color: #1a1a1a;
            box-shadow: none;
        }

    .btn-dark {
        background-color: #1a1a1a;
        border: none;
        border-radius: 0;
        font-weight: 500;
        font-size: 14px;
        padding: 10px 28px;
        color: #fff;
        transition: background 0.2s;
    }

        .btn-dark:hover {
            background-color: #333;
            color: #fff;
        }

    .btn-outline-secondary {
        border-radius: 0;
        border-color: #ddd;
        color: #555;
        font-size: 14px;
        padding: 10px 28px;
    }

        .btn-outline-secondary:hover {
            background: #f0eeeb;
            border-color: #ccc;
        }

    .text-danger {
        color: #c62828 !important;
        font-size: 13px;
    }
</style>