@model IEnumerable<Category>

@{
    ViewData["Title"] = "Управление категориями";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="page-title">Управление категориями</h2>
        <a asp-action="Create" class="btn btn-dark btn-sm rounded-pill px-4">Добавить категорию</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <p class="text-muted">Категорий пока нет</p>
            <a asp-action="Create" class="btn btn-dark rounded-pill px-4">Добавить первую категорию</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Название</th>
                        <th>Описание</th>
                        <th>Товаров</th>
                        <th style="text-align: right;">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var productCount = item.Products?.Count ?? 0;
                        <tr>
                            <td>@item.Id</td>
                            <td><strong>@item.Name</strong></td>
                            <td>@(item.Description ?? "—")</td>
                            <td>@productCount</td>
                            <td style="text-align: right;">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark">Редактировать</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Удалить</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<style>
    .page-title {
        font-size: 24px;
        font-weight: 700;
        color: #1a1a1a;
    }

    .btn-dark {
        background-color: #1a1a1a;
        border: none;
        border-radius: 50px;
        font-weight: 500;
        font-size: 13px;
        padding: 8px 20px;
        color: #fff;
        text-decoration: none;
        display: inline-block;
        transition: background 0.2s;
    }

        .btn-dark:hover {
            background-color: #333;
            color: #fff;
        }

    .btn-outline-dark {
        border-radius: 0;
        border-color: #ddd;
        color: #555;
        font-size: 12px;
        padding: 4px 12px;
    }

        .btn-outline-dark:hover {
            background: #1a1a1a;
            color: #fff;
            border-color: #1a1a1a;
        }

    .btn-outline-danger {
        border-radius: 0;
        border-color: #dc3545;
        color: #dc3545;
        font-size: 12px;
        padding: 4px 12px;
    }

        .btn-outline-danger:hover {
            background: #dc3545;
            color: #fff;
        }

    .table {
        font-size: 14px;
        border-collapse: collapse;
    }

        .table th {
            background: #f5f5f5;
            font-weight: 600;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.3px;
            color: #888;
            padding: 10px 14px;
            border-bottom: 1px solid #e8e7e4;
        }

        .table td {
            padding: 10px 14px;
            border-bottom: 1px solid #f0eeeb;
            vertical-align: middle;
        }

    .alert {
        padding: 12px 20px;
        border-radius: 0;
        border: none;
        font-size: 14px;
        margin-bottom: 20px;
    }

    .alert-success {
        background: #e8f5e9;
        color: #2e7d32;
    }

    .alert-danger {
        background: #fbe9e7;
        color: #c62828;
    }
</style>