@model Category

@{
    ViewData["Title"] = "Удалить категорию";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-white">
                    <h2 class="card-title text-danger">Удалить категорию</h2>
                </div>
                <div class="card-body">
                    <p class="lead">Вы уверены, что хотите удалить категорию?</p>

                    <table class="table">
                        <tr>
                            <td class="fw-bold">Название</td>
                            <td>@Model.Name</td>
                        </tr>
                        <tr>
                            <td class="fw-bold">Описание</td>
                            <td>@(Model.Description ?? "—")</td>
                        </tr>
                        <tr>
                            <td class="fw-bold">Товаров в категории</td>
                            <td>@(Model.Products?.Count ?? 0)</td>
                        </tr>
                    </table>

                    @if (Model.Products != null && Model.Products.Any())
                    {
                        <div class="alert alert-danger">
                            <strong>Внимание!</strong> В этой категории есть товары. Удаление невозможно.
                            Сначала переместите или удалите все товары из этой категории.
                        </div>

                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Назад</a>
                    }
                    else
                    {
                        <form asp-action="DeleteConfirmed" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-danger px-4">Удалить</button>
                                <a asp-action="Index" class="btn btn-outline-secondary px-4">Отмена</a>
                            </div>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        border: 1px solid #e8e7e4;
        border-radius: 0;
    }

    .card-header {
        border-bottom: 1px solid #e8e7e4;
        padding: 16px 24px;
    }

    .card-title {
        font-size: 20px;
        font-weight: 700;
        margin: 0;
    }

    .card-body {
        padding: 24px;
    }

    .lead {
        font-size: 16px;
        color: #555;
        margin-bottom: 20px;
    }

    .table {
        font-size: 14px;
        margin-bottom: 20px;
    }

        .table td {
            padding: 8px 0;
            border: none;
            border-bottom: 1px solid #f0eeeb;
        }

        .table tr:last-child td {
            border-bottom: none;
        }

    .fw-bold {
        font-weight: 600;
        color: #555;
        width: 180px;
    }

    .alert-danger {
        background: #fbe9e7;
        color: #c62828;
        padding: 12px 16px;
        border: none;
        border-left: 3px solid #c62828;
        border-radius: 0;
        font-size: 14px;
        margin-bottom: 20px;
    }

    .btn-danger {
        background: #dc3545;
        border: none;
        border-radius: 0;
        font-weight: 500;
        font-size: 14px;
        padding: 10px 28px;
        color: #fff;
        transition: background 0.2s;
    }

        .btn-danger:hover {
            background: #c62828;
            color: #fff;
        }

    .btn-outline-secondary {
        border-radius: 0;
        border-color: #ddd;
        color: #555;
        font-size: 14px;
        padding: 10px 28px;
    }

        .btn-outline-secondary:hover {
            background: #f0eeeb;
            border-color: #ccc;
        }

    .text-danger {
        color: #c62828 !important;
    }
</style>