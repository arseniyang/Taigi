@using Microsoft.AspNetCore.Identity
@using ShopProject.Data

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TAIGI</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ShopProject.styles.css" asp-append-version="true" />
</head>
<body>

    <!-- ================================================================ -->
    <!-- ШАПКА                                                           -->
    <!-- ================================================================ -->
    <header class="taigi-header">
        <div class="container-fluid px-3 px-md-4">
            <div class="d-flex align-items-center justify-content-between py-2">

                <!-- ЛОГОТИП -->
                <div class="d-flex align-items-center gap-2">
                    <a class="taigi-logo" asp-controller="Home" asp-action="Index">
                        <span class="taigi-logo-text">TAIGI</span>
                    </a>
                    <span class="taigi-logo-sub d-none d-md-inline">сибирский характер</span>
                </div>

                <!-- НАВИГАЦИЯ (только десктоп) -->
                <nav class="d-none d-lg-flex align-items-center gap-4 taigi-nav desktop-nav">
                    <a asp-controller="Home" asp-action="Index" class="taigi-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">Главная</a>
                    <a asp-controller="Catalog" asp-action="Index" class="taigi-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Catalog" ? "active" : "")">Каталог</a>
                    @if (User.Identity.IsAuthenticated)
                    {
                        <a asp-controller="Orders" asp-action="Index" class="taigi-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Orders" ? "active" : "")">Мои заказы</a>
                        <a asp-controller="Wishlist" asp-action="Index" class="taigi-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Wishlist" ? "active" : "")">Избранное</a>
                    }
                </nav>

                <!-- ПРАВАЯ ЧАСТЬ -->
                <div class="d-flex align-items-center gap-3">

                    <!-- КОРЗИНА (видна всегда) -->
                    <a asp-controller="Cart" asp-action="Index" class="taigi-cart">
                        <i class="bi bi-bag-fill taigi-cart-icon"></i>
                        @if (Context.Session.GetInt32("CartCount") > 0)
                        {
                            <span class="taigi-cart-badge">@Context.Session.GetInt32("CartCount")</span>
                        }
                    </a>

                    <span class="taigi-divider d-none d-sm-inline"></span>

                    <!-- ПРОФИЛЬ / ВХОД (скрывается на мобильных) -->
                    <div class="d-none d-sm-block">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <div class="dropdown">
                                <button class="taigi-profile-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person"></i>
                                    <span class="d-none d-md-inline">@User.Identity?.Name</span>
                                </button>
                                <ul class="dropdown-menu taigi-dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile">Профиль</a></li>
                                    <li><a class="dropdown-item" asp-controller="Orders" asp-action="Index">Мои заказы</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li><a class="dropdown-item" asp-controller="AdminOrders" asp-action="Index">Заказы</a></li>
                                        <li><a class="dropdown-item" asp-controller="Products" asp-action="Index">Товары</a></li>
                                        <li><a class="dropdown-item" asp-controller="Categories" asp-action="Index">Категории</a></li>
                                        <li><a class="dropdown-item" asp-controller="PromoCodes" asp-action="Index">Промокоды</a></li>
                                        <li><hr class="dropdown-divider" /></li>
                                    }
                                    <li>
                                        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                                            <button type="submit" class="dropdown-item text-danger">Выйти</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex gap-2">
                                <a asp-area="Identity" asp-page="/Account/Login" class="taigi-auth-link">Войти</a>
                                <span class="taigi-divider d-none d-sm-inline"></span>
                                <a asp-area="Identity" asp-page="/Account/Register" class="taigi-auth-link d-none d-sm-inline">Регистрация</a>
                            </div>
                        }
                    </div>

                    <!-- БУРГЕР (только мобильные) -->
                    <button class="taigi-burger d-lg-none" type="button" data-bs-toggle="collapse" data-bs-target="#mobileMenu">
                        <i class="bi bi-list"></i>
                    </button>
                </div>
            </div>

            <!-- МОБИЛЬНОЕ МЕНЮ (бургер) -->
            <div class="collapse d-lg-none" id="mobileMenu">
                <div class="taigi-mobile-menu">
                    <a asp-controller="Home" asp-action="Index" class="taigi-mobile-link">Главная</a>
                    <a asp-controller="Catalog" asp-action="Index" class="taigi-mobile-link">Каталог</a>
                    @if (User.Identity.IsAuthenticated)
                    {
                        <a asp-controller="Orders" asp-action="Index" class="taigi-mobile-link">Мои заказы</a>
                        <a asp-controller="Account" asp-action="Profile" class="taigi-mobile-link">Профиль</a>
                        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post" class="taigi-mobile-logout-form">
                            <button type="submit" class="taigi-mobile-link taigi-mobile-logout-btn">Выйти</button>
                        </form>
                    }
                    else
                    {
                        <a asp-area="Identity" asp-page="/Account/Login" class="taigi-mobile-link">Войти</a>
                        <a asp-area="Identity" asp-page="/Account/Register" class="taigi-mobile-link">Регистрация</a>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <hr />
                        <a asp-controller="AdminOrders" asp-action="Index" class="taigi-mobile-link">Заказы</a>
                        <a asp-controller="Products" asp-action="Index" class="taigi-mobile-link">Товары</a>
                        <a asp-controller="PromoCodes" asp-action="Index" class="taigi-mobile-link">Промокоды</a>
                    }
                </div>
            </div>
        </div>
    </header>

    <!-- ================================================================ -->
    <!-- ОСНОВНОЙ КОНТЕНТ                                                -->
    <!-- ================================================================ -->
    <main class="taigi-main">
        <!-- ===== КОНТЕЙНЕР ДЛЯ ВСЕХ УВЕДОМЛЕНИЙ ===== -->
        <div id="notificationContainer" style="position: fixed; top: 20px; right: 20px; z-index: 9999; max-width: 400px; width: 100%;"></div>
        @RenderBody()
    </main>

    <!-- ================================================================ -->
    <!-- ПОДВАЛ                                                          -->
    <!-- ================================================================ -->
    <footer class="taigi-footer">
        <div class="container">
            <div class="row g-4 py-5">
                <div class="col-lg-4 col-md-6">
                    <h5 class="taigi-footer-title">TAIGI</h5>
                    <p class="taigi-footer-text">
                        Локальный сибирский бренд концептуальной женской одежды.
                        Симбиоз уличного стиля, абсолютного комфорта и эстетики дикой природы.
                    </p>
                    <div class="d-flex gap-3 mt-3">
                        <a href="#" class="taigi-social"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="taigi-social"><i class="bi bi-telegram"></i></a>
                        <a href="#" class="taigi-social"><i class="bi bi-vk"></i></a>
                        <a href="#" class="taigi-social"><i class="bi bi-youtube"></i></a>
                    </div>
                </div>

                <div class="col-lg-2 col-md-6">
                    <h5 class="taigi-footer-title">Каталог</h5>
                    <ul class="list-unstyled">
                        <li><a asp-controller="Catalog" asp-action="Index" class="taigi-footer-link">Все товары</a></li>
                        <li><a asp-controller="Catalog" asp-action="Index" asp-route-categoryId="1" class="taigi-footer-link">Одежда</a></li>
                        <li><a asp-controller="Catalog" asp-action="Index" asp-route-categoryId="2" class="taigi-footer-link">Аксессуары</a></li>
                        <li><a asp-controller="Catalog" asp-action="Index" asp-route-categoryId="3" class="taigi-footer-link">Обувь</a></li>
                    </ul>
                </div>

                <div class="col-lg-2 col-md-6">
                    <h5 class="taigi-footer-title">Помощь</h5>
                    <ul class="list-unstyled">
                        <li><a href="#" class="taigi-footer-link">Доставка</a></li>
                        <li><a href="#" class="taigi-footer-link">Оплата</a></li>
                        <li><a href="#" class="taigi-footer-link">Возврат</a></li>
                        <li><a href="#" class="taigi-footer-link">Контакты</a></li>
                    </ul>
                </div>

                <div class="col-lg-4 col-md-6">
                    <h5 class="taigi-footer-title">Связь с нами</h5>
                    <ul class="list-unstyled taigi-footer-text">
                        <li class="mb-2"><i class="bi bi-geo-alt-fill me-2 text-success"></i> Иркутск, Сибирь</li>
                        <li class="mb-2"><i class="bi bi-envelope-fill me-2 text-success"></i> info@taigi.ru</li>
                        <li class="mb-2"><i class="bi bi-clock-fill me-2 text-success"></i> Ежедневно 10:00 – 21:00</li>
                        <li><i class="bi bi-truck-fill me-2 text-success"></i> Доставка по всей России</li>
                    </ul>
                </div>
            </div>
            <!-- ===== ЮРИДИЧЕСКИЕ ДОКУМЕНТЫ ===== -->
            <div class="col-lg-4 col-md-6">
                <h5 class="taigi-footer-title">Юридическая информация</h5>
                <ul class="list-unstyled taigi-footer-text">
                    <li class="mb-2">
                        <i class="bi bi-file-text-fill me-2 text-success"></i>
                        <a asp-controller="Legal" asp-action="Oferta" class="taigi-footer-link">Публичная оферта</a>
                    </li>
                    <li class="mb-2">
                        <i class="bi bi-arrow-return-left me-2 text-success"></i>
                        <a asp-controller="Legal" asp-action="Refund" class="taigi-footer-link">Политика возврата</a>
                    </li>
                    <li class="mb-2">
                        <i class="bi bi-shield-lock-fill me-2 text-success"></i>
                        <a asp-controller="Legal" asp-action="Privacy" class="taigi-footer-link">Политика конфиденциальности</a>
                    </li>
                    <li>
                        <i class="bi bi-person-check-fill me-2 text-success"></i>
                        <a asp-controller="Legal" asp-action="Privacy" class="taigi-footer-link">Согласие на обработку ПД</a>
                    </li>
                </ul>
            </div>
            <div class="taigi-copyright py-3">
                <div class="d-flex justify-content-between align-items-center flex-wrap">
                    <span>© 2026 TAIGI — сибирский характер</span>
                    <span class="d-flex justify-content-between align-items-center flex-wrap">Сделано с любовью в Сибири</span>
                </div>
            </div>
        </div>
    </footer>

    <!-- ================================================================ -->
    <!-- СКРИПТЫ                                                         -->
    <!-- ================================================================ -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <!-- ===== МОБИЛЬНОЕ НИЖНЕЕ МЕНЮ ===== -->
    <partial name="_MobileBottomNav" />
    <script>
            document.addEventListener('DOMContentLoaded', function() {
                document.querySelectorAll('.taigi-alert-close').forEach(function(btn) {
                    btn.addEventListener('click', function() {
                        var alert = this.closest('.taigi-alert');
                        if (alert) {
                            alert.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
                            alert.style.opacity = '0';
                            alert.style.transform = 'translateY(-10px)';
                            setTimeout(function() {
                                if (alert.parentNode) alert.remove();
                            }, 350);
                        }
                    });
                });

                document.querySelectorAll('.taigi-alert').forEach(function(alert) {
                    setTimeout(function() {
                        if (alert && alert.parentNode) {
                            alert.style.transition = 'opacity 0.5s ease';
                            alert.style.opacity = '0';
                            setTimeout(function() {
                                if (alert.parentNode) alert.remove();
                            }, 500);
                        }
                    }, 5000);
                });
            });
    </script>
</body>
</html>