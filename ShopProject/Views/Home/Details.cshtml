@model Product
@{
    ViewData["Title"] = Model.Name;
}

<div class="container">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Каталог</a></li>
            <li class="breadcrumb-item"><a asp-action="Index" asp-route-categoryId="@Model.CategoryId">@Model.Category?.Name</a></li>
            <li class="breadcrumb-item active">@Model.Name</li>
        </ol>
    </nav>

    <div class="row">
        <!-- Галерея -->
        <div class="col-md-6">
            @if (Model.Images.Any())
            {
                var mainImage = Model.Images.OrderBy(i => i.DisplayOrder).First();
                <div class="mb-3">
                    <img id="mainImage" src="@mainImage.ImageUrl" alt="@Model.Name" class="img-fluid rounded" style="width: 100%; max-height: 400px; object-fit: contain;" />
                </div>
                @if (Model.Images.Count > 1)
                {
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var img in Model.Images.OrderBy(i => i.DisplayOrder))
                        {
                            <img src="@img.ImageUrl"
                                 alt="@Model.Name"
                                 class="img-thumbnail"
                                 style="width: 70px; height: 70px; object-fit: cover; cursor: pointer;"
                                 onclick="document.getElementById('mainImage').src = this.src;" />
                        }
                    </div>
                }
            }
            else
            {
                <div class="bg-light d-flex align-items-center justify-content-center rounded" style="height: 300px;">
                    <span class="text-muted">Нет изображений</span>
                </div>
            }
        </div>

        <!-- Информация -->
        <div class="col-md-6">
            <h2>@Model.Name</h2>
            <p class="text-muted">Категория: @Model.Category?.Name</p>
            <h3 class="text-success">@Model.Price.ToString("C")</h3>

            @if (Model.StockQuantity.HasValue && Model.StockQuantity > 0)
            {
                <p class="text-success"><strong>В наличии: @Model.StockQuantity шт.</strong></p>
            }
            else
            {
                <p class="text-danger"><strong>Нет в наличии</strong></p>
            }

            <p class="mt-3">@Model.Description</p>

            <div class="mt-4">
                <form asp-controller="Cart" asp-action="Add" method="post">
                    <input type="hidden" name="productId" value="@Model.Id" />
                    <div class="input-group w-50">
                        <button type="submit" class="btn btn-success btn-lg">🛒 В корзину</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>