@model ChangePasswordViewModel

@{
    ViewData["Title"] = "Смена пароля";
}

<div class="container py-4" style="max-width: 640px;">
    <h2 class="page-title">Смена пароля</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success-custom alert-dismissible fade show" role="alert">
            <span>@TempData["Success"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Навигация по кабинету -->
    <ul class="account-nav">
        <li class="account-nav-item">
            <a class="account-nav-link" asp-action="Profile">Профиль</a>
        </li>
        <li class="account-nav-item">
            <a class="account-nav-link active" asp-action="ChangePassword">Пароль</a>
        </li>
        <li class="account-nav-item">
            <a class="account-nav-link" asp-controller="Orders" asp-action="Index">Заказы</a>
        </li>
    </ul>

    <!-- Форма смены пароля -->
    <form method="post" class="account-form">
        <div asp-validation-summary="ModelOnly" class="account-error"></div>

        <div class="account-form-group">
            <label asp-for="CurrentPassword" class="account-label">Текущий пароль</label>
            <input asp-for="CurrentPassword" class="account-input" type="password" />
            <span asp-validation-for="CurrentPassword" class="account-error"></span>
        </div>

        <div class="account-form-group">
            <label asp-for="NewPassword" class="account-label">Новый пароль</label>
            <input asp-for="NewPassword" class="account-input" type="password" />
            <span asp-validation-for="NewPassword" class="account-error"></span>
        </div>

        <div class="account-form-group">
            <label asp-for="ConfirmPassword" class="account-label">Подтверждение пароля</label>
            <input asp-for="ConfirmPassword" class="account-input" type="password" />
            <span asp-validation-for="ConfirmPassword" class="account-error"></span>
        </div>

        <button type="submit" class="account-btn">Сменить пароль</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
    /* ===== TAIGI — СМЕНА ПАРОЛЯ ===== */

    .page-title {
        font-size: 28px;
        font-weight: 700;
        color: #1a1a1a;
        letter-spacing: 1px;
        margin-bottom: 28px;
    }

    /* ===== НАВИГАЦИЯ ===== */
    .account-nav {
        display: flex;
        gap: 4px;
        padding: 0;
        margin: 0 0 32px 0;
        list-style: none;
        border-bottom: 1px solid #e8e7e4;
    }

    .account-nav-item {
        margin: 0;
    }

    .account-nav-link {
        display: block;
        padding: 10px 20px;
        color: #999;
        font-size: 14px;
        font-weight: 500;
        text-decoration: none;
        letter-spacing: 0.3px;
        border-bottom: 2px solid transparent;
        transition: all 0.2s ease;
    }

        .account-nav-link:hover {
            color: #1a1a1a;
        }

        .account-nav-link.active {
            color: #1a1a1a;
            border-bottom-color: #1a1a1a;
        }

    /* ===== ФОРМА ===== */
    .account-form {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .account-form-group {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .account-label {
        font-size: 13px;
        font-weight: 600;
        color: #555;
        letter-spacing: 0.3px;
        text-transform: uppercase;
    }

    .account-input {
        padding: 10px 14px;
        border: 1px solid #ddd;
        border-radius: 0;
        font-size: 15px;
        background: #fff;
        transition: border-color 0.2s ease;
        width: 100%;
    }

        .account-input:focus {
            border-color: #1a1a1a;
            outline: none;
            box-shadow: none;
        }

    .account-error {
        font-size: 13px;
        color: #dc3545;
        margin-top: 2px;
    }

    .account-btn {
        padding: 12px 40px;
        background: #1a1a1a;
        color: #fff;
        border: none;
        border-radius: 50px;
        font-size: 14px;
        font-weight: 600;
        letter-spacing: 0.5px;
        cursor: pointer;
        transition: background 0.2s ease;
        align-self: flex-start;
        margin-top: 8px;
    }

        .account-btn:hover {
            background: #333;
        }

    /* ===== СООБЩЕНИЯ ===== */
    .alert-success-custom {
        padding: 12px 20px;
        border-radius: 0;
        border: none;
        font-size: 14px;
        margin-bottom: 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #e8f5e9;
        color: #2e7d32;
    }

    /* ===== АДАПТИВ ===== */
    @@media (max-width: 768px) {
        .page-title {
            font-size: 22px;
        }

        .account-nav-link {
            font-size: 13px;
            padding: 8px 14px;
        }

        .account-btn {
            width: 100%;
            justify-content: center;
            padding: 14px;
        }
    }

    @@media (max-width: 576px) {
        .page-title {
            font-size: 18px;
        }

        .account-nav {
            gap: 0;
            overflow-x: auto;
            flex-wrap: nowrap;
        }

        .account-nav-link {
            font-size: 12px;
            padding: 8px 12px;
            white-space: nowrap;
        }

        .account-input {
            font-size: 14px;
            padding: 8px 12px;
        }

        .account-label {
            font-size: 12px;
        }
    }
</style>