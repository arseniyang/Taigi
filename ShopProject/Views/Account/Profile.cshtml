@model ProfileViewModel

@{
    ViewData["Title"] = "Личный кабинет";
}

<div class="container py-4" style="max-width: 640px;">
    <h2 class="page-title">Личный кабинет</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success-custom alert-dismissible fade show" role="alert">
            <span>@TempData["Success"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger-custom alert-dismissible fade show" role="alert">
            <span>@TempData["Error"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Info"] != null)
    {
        <div class="alert alert-info-custom alert-dismissible fade show" role="alert">
            <span>@TempData["Info"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Навигация по кабинету -->
    <ul class="account-nav">
        <li class="account-nav-item">
            <a class="account-nav-link active" asp-action="Profile">Профиль</a>
        </li>
        <li class="account-nav-item">
            <a class="account-nav-link" asp-action="ChangePassword">Пароль</a>
        </li>
        <li class="account-nav-item">
            <a class="account-nav-link" asp-controller="Orders" asp-action="Index">Заказы</a>
        </li>
    </ul>

          <!-- ===== СТАТУС ПОДТВЕРЖДЕНИЯ EMAIL ===== -->
    @{
        bool isEmailConfirmed = ViewBag.IsEmailConfirmed != null && (bool)ViewBag.IsEmailConfirmed;
    }
    <div class="email-status @(isEmailConfirmed ? "email-confirmed" : "email-not-confirmed")">
        @if (isEmailConfirmed)
        {
            <span class="email-status-icon"></span>
            <span class="email-status-text">Email подтверждён</span>
        }
        else
        {
            <span class="email-status-icon"></span>
            <span class="email-status-text">Email не подтверждён</span>
            <form asp-action="SendEmailConfirmation" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="email-resend-btn">Отправить письмо повторно</button>
            </form>
        }
    </div>

    <!-- Форма профиля -->
    <form method="post" class="account-form">
        <div class="account-form-group">
            <label asp-for="Email" class="account-label">Email</label>
            <input asp-for="Email" class="account-input" disabled />
        </div>

        <div class="account-form-group">
            <label asp-for="FirstName" class="account-label">Имя</label>
            <input asp-for="FirstName" class="account-input" />
            <span asp-validation-for="FirstName" class="account-error"></span>
        </div>

        <div class="account-form-group">
            <label asp-for="LastName" class="account-label">Фамилия</label>
            <input asp-for="LastName" class="account-input" />
            <span asp-validation-for="LastName" class="account-error"></span>
        </div>

        <div class="account-form-group">
            <label asp-for="PhoneNumber" class="account-label">Телефон</label>
            <input asp-for="PhoneNumber" class="account-input" />
            <span asp-validation-for="PhoneNumber" class="account-error"></span>
        </div>

        <div class="account-form-group">
            <label asp-for="DateOfBirth" class="account-label">Дата рождения</label>
            <input asp-for="DateOfBirth" class="account-input" type="date" />
            <span asp-validation-for="DateOfBirth" class="account-error"></span>
        </div>

        <button type="submit" class="account-btn">Сохранить</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
    /* ===== TAIGI — ЛИЧНЫЙ КАБИНЕТ ===== */

    .page-title {
        font-size: 28px;
        font-weight: 700;
        color: #1a1a1a;
        letter-spacing: 1px;
        margin-bottom: 28px;
    }

    /* ===== НАВИГАЦИЯ ===== */
    .account-nav {
        display: flex;
        gap: 4px;
        padding: 0;
        margin: 0 0 32px 0;
        list-style: none;
        border-bottom: 1px solid #e8e7e4;
    }

    .account-nav-item {
        margin: 0;
    }

    .account-nav-link {
        display: block;
        padding: 10px 20px;
        color: #999;
        font-size: 14px;
        font-weight: 500;
        text-decoration: none;
        letter-spacing: 0.3px;
        border-bottom: 2px solid transparent;
        transition: all 0.2s ease;
    }

        .account-nav-link:hover {
            color: #1a1a1a;
        }

        .account-nav-link.active {
            color: #1a1a1a;
            border-bottom-color: #1a1a1a;
        }

    /* ===== СТАТУС EMAIL ===== */
    .email-status {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 16px;
        margin-bottom: 24px;
        border-left: 3px solid #1a1a1a;
        background: #f8f7f5;
        flex-wrap: wrap;
    }

    .email-confirmed {
        border-left-color: #2d7d46;
        background: #d5f2df;
    }

    .email-not-confirmed {
        border-left-color: #c62828;
        background: #fbe9e7;
    }

    .email-status-icon {
        font-size: 18px;
    }

    .email-status-text {
        font-size: 14px;
        font-weight: 500;
        color: #1a1a1a;
        flex: 1;
    }

    .email-resend-btn {
        background: none;
        border: none;
        color: #1a1a1a;
        font-size: 13px;
        font-weight: 600;
        text-decoration: underline;
        cursor: pointer;
        padding: 4px 8px;
        transition: color 0.2s ease;
    }

        .email-resend-btn:hover {
            color: #c62828;
        }

    /* ===== ФОРМА ===== */
    .account-form {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .account-form-group {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .account-label {
        font-size: 13px;
        font-weight: 600;
        color: #555;
        letter-spacing: 0.3px;
        text-transform: uppercase;
    }

    .account-input {
        padding: 10px 14px;
        border: 1px solid #ddd;
        border-radius: 0;
        font-size: 15px;
        background: #fff;
        transition: border-color 0.2s ease;
        width: 100%;
    }

        .account-input:focus {
            border-color: #1a1a1a;
            outline: none;
            box-shadow: none;
        }

        .account-input:disabled {
            background: #f5f5f5;
            color: #999;
            cursor: not-allowed;
        }

    .account-error {
        font-size: 13px;
        color: #dc3545;
        margin-top: 2px;
    }

    .account-btn {
        padding: 12px 40px;
        background: #1a1a1a;
        color: #fff;
        border: none;
        border-radius: 50px;
        font-size: 14px;
        font-weight: 600;
        letter-spacing: 0.5px;
        cursor: pointer;
        transition: background 0.2s ease;
        align-self: flex-start;
        margin-top: 8px;
    }

        .account-btn:hover {
            background: #333;
        }

    /* ===== СООБЩЕНИЯ ===== */
    .alert-success-custom,
    .alert-danger-custom,
    .alert-info-custom {
        padding: 12px 20px;
        border-radius: 0;
        border: none;
        font-size: 14px;
        margin-bottom: 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .alert-success-custom {
        background: #e8f5e9;
        color: #2e7d32;
    }

    .alert-danger-custom {
        background: #fbe9e7;
        color: #c62828;
    }

    .alert-info-custom {
        background: #e3f2fd;
        color: #0d47a1;
    }

    /* ===== АДАПТИВ ===== */
    @@media (max-width: 768px) {
        .page-title {
            font-size: 22px;
        }

        .account-nav-link {
            font-size: 13px;
            padding: 8px 14px;
        }

        .account-btn {
            width: 100%;
            justify-content: center;
            padding: 14px;
        }

        .email-status {
            flex-direction: column;
            align-items: flex-start;
            gap: 6px;
        }
    }

    @@media (max-width: 576px) {
        .page-title {
            font-size: 18px;
        }

        .account-nav {
            gap: 0;
            overflow-x: auto;
            flex-wrap: nowrap;
        }

        .account-nav-link {
            font-size: 12px;
            padding: 8px 12px;
            white-space: nowrap;
        }

        .account-input {
            font-size: 14px;
            padding: 8px 12px;
        }

        .account-label {
            font-size: 12px;
        }
    }
</style>