@model PaginatedList<Product>

@{
    ViewData["Title"] = "Управление товарами";
    var searchQuery = ViewBag.SearchQuery as string;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="page-title">Управление товарами</h2>
        <a asp-action="Create" class="btn btn-dark btn-sm rounded-pill px-4">Добавить товар</a>
    </div>
    <!-- ===== ПОИСК ===== -->
    <div class="admin-search-bar mb-4">
        <form method="get" asp-action="Index" class="admin-search-form">
            <div class="admin-search-wrapper">
                <i class="bi bi-search admin-search-icon"></i>
                <input type="text"
                       name="searchQuery"
                       value="@(ViewBag.SearchQuery as string)"
                       class="admin-search-input"
                       placeholder="Поиск по названию, артикулу или категории..." />
                @if (!string.IsNullOrEmpty(ViewBag.SearchQuery as string))
                {
                    <a asp-action="Index" class="admin-search-clear" title="Очистить">
                        <i class="bi bi-x"></i>
                    </a>
                }
            </div>
            <button type="submit" class="admin-search-btn">Найти</button>
        </form>

        @if (!string.IsNullOrEmpty(ViewBag.SearchQuery as string))
        {
            <p class="admin-search-result">
                Найдено: <strong>@ViewBag.TotalItems</strong> товаров по запросу «@ViewBag.SearchQuery»
            </p>
        }
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success-custom alert-dismissible fade show" role="alert">
            <span>@TempData["Success"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger-custom alert-dismissible fade show" role="alert">
            <span>@TempData["Error"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            @if (!string.IsNullOrEmpty(searchQuery))
            {
                <p class="text-muted">По запросу «@searchQuery» ничего не найдено.</p>
                <a asp-action="Index" class="btn btn-dark rounded-pill px-4">Сбросить поиск</a>
            }
            else
            {
                <p class="text-muted">Товаров пока нет.</p>
                <a asp-action="Create" class="btn btn-dark rounded-pill px-4">Добавить первый товар</a>
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table-admin">
                <thead>
                    <tr>
                        <th style="width: 60px;">Фото</th>
                        <th>Артикул</th>
                        <th>Название</th>
                        <th>Категория</th>
                        <th>Цена</th>
                        <th>Размеры</th>
                        <th style="text-align: center;">Остаток</th>
                        <th>Статус</th>
                        <th style="text-align: right;">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="@(!item.IsActive ? "table-inactive" : "")">
                            <td>
                                @if (item.Images.Any())
                                {
                                    <img src="@item.Images.OrderBy(i => i.DisplayOrder).First().ImageUrl"
                                         alt="@item.Name"
                                         class="product-thumb" />
                                }
                                else
                                {
                                    <span class="text-muted small">Нет фото</span>
                                }
                            </td>
                            <td>@(item.Article ?? "—")</td>
                            <td>@item.Name</td>
                            <td>@item.Category?.Name</td>
                            <td>
                                <span class="fw-bold">@item.Price.ToString("N0") ₽</span>
                                @if (item.OldPrice.HasValue && item.OldPrice > item.Price)
                                {
                                    <br />
                                    <span class="text-decoration-line-through text-muted small">@item.OldPrice.Value.ToString("N0") ₽</span>
                                    <span class="badge badge-discount">-@item.DiscountPercent%</span>
                                }
                            </td>
                            <td>
                                @if (item.HasSizes && item.Sizes != null && item.Sizes.Any())
                                {
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var size in item.Sizes.OrderBy(s => s.Size))
                                        {
                                            if (size.IsAvailable)
                                            {
                                                <span class="size-badge size-available">@size.Size</span>
                                            }
                                            else
                                            {
                                                <span class="size-badge size-unavailable">@size.Size</span>
                                            }
                                        }
                                    </div>
                                    var hiddenCount = item.Sizes.Count(s => !s.IsAvailable);
                                    if (hiddenCount > 0)
                                    {
                                        <span class="size-hidden-count">+@hiddenCount скрыты</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td style="text-align: center;">
                                @{
                                    int totalStock = 0;
                                    if (item.Sizes != null && item.Sizes.Any())
                                    {
                                        totalStock = item.Sizes.Where(s => s.IsAvailable).Sum(s => s.StockQuantity);
                                    }
                                }
                                @if (totalStock > 0)
                                {
                                    <span class="stock-badge stock-in-stock">@totalStock шт.</span>
                                }
                                else if (item.Sizes != null && item.Sizes.Any(s => s.IsAvailable))
                                {
                                    <span class="stock-badge stock-low">0 шт.</span>
                                }
                                else
                                {
                                    <span class="stock-badge stock-out">Нет</span>
                                }
                            </td>
                            <td>
                                @if (!item.IsActive)
                                {
                                    <span class="status-badge status-inactive">Скрыт</span>
                                }
                                else
                                {
                                    <span class="status-badge status-active">Активен</span>
                                }
                            </td>
                            <td style="text-align: right;">
                                <div class="d-flex justify-content-end gap-1">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn-action" title="Редактировать">✎</a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn-action" title="Детали">ⓘ</a>
                                    <a asp-controller="ProductSizes" asp-action="Index" asp-route-productId="@item.Id" class="btn-action" title="Размеры">◰</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn-action text-danger" title="Удалить">✕</a>
                                    @if (item.IsActive)
                                    {
                                        <form asp-action="Hide" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn-action" title="Скрыть">◉</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Unhide" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn-action" title="Показать">◎</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <!-- ===== ПАГИНАЦИЯ ===== -->
            @if (Model.TotalPages > 1)
            {
                <div class="admin-pagination">
                    <div class="admin-pagination-info">
                        Страница @Model.PageIndex из @Model.TotalPages
                        (всего @Model.TotalCount товаров)
                    </div>

                    <nav class="admin-pagination-nav">
                        @if (Model.HasPreviousPage)
                        {
                            <a asp-action="Index"
                               asp-route-page="@(Model.PageIndex - 1)"
                               asp-route-searchQuery="@searchQuery"
                               class="admin-page-btn">
                                ← Назад
                            </a>
                        }
                        else
                        {
                            <span class="admin-page-btn admin-page-btn-disabled">← Назад</span>
                        }

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            if (i == Model.PageIndex)
                            {
                                <span class="admin-page-btn admin-page-btn-active">@i</span>
                            }
                            else if (i == 1 || i == Model.TotalPages || Math.Abs(i - Model.PageIndex) <= 2)
                            {
                                <a asp-action="Index"
                                   asp-route-page="@i"
                                   asp-route-searchQuery="@searchQuery"
                                   class="admin-page-btn">@i</a>
                            }
                            else if (Math.Abs(i - Model.PageIndex) == 3)
                            {
                                <span class="admin-page-dots">...</span>
                            }
                        }

                        @if (Model.HasNextPage)
                        {
                            <a asp-action="Index"
                               asp-route-page="@(Model.PageIndex + 1)"
                               asp-route-searchQuery="@searchQuery"
                               class="admin-page-btn">
                                Вперёд →
                            </a>
                        }
                        else
                        {
                            <span class="admin-page-btn admin-page-btn-disabled">Вперёд →</span>
                        }
                    </nav>
                </div>
            }
        </div>
    }
</div>

<style>
    /* ================================================================
           TAIGI — АДМИНКА ТОВАРОВ
           ================================================================ */

    .page-title {
        font-size: 24px;
        font-weight: 700;
        color: #1a1a1a;
        letter-spacing: 0.5px;
    }

    /* ---------- ТАБЛИЦА ---------- */
    .table-admin {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
        background: #fff;
    }

        .table-admin thead th {
            padding: 12px 14px;
            background: #f5f5f5;
            font-weight: 600;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #888;
            border-bottom: 1px solid #e8e7e4;
            text-align: left;
        }

        .table-admin tbody td {
            padding: 10px 14px;
            vertical-align: middle;
            border-bottom: 1px solid #f0eeeb;
        }

        .table-admin tbody tr:hover {
            background-color: #f8f7f5;
        }

        .table-admin .table-inactive {
            opacity: 0.6;
        }

    /* ---------- ФОТО ---------- */
    .product-thumb {
        width: 44px;
        height: 44px;
        object-fit: cover;
        border: 1px solid #f0eeeb;
        background: #f5f5f5;
    }

    /* ---------- РАЗМЕРЫ ---------- */
    .size-badge {
        display: inline-block;
        font-size: 11px;
        font-weight: 600;
        padding: 2px 8px;
        border-radius: 50px;
        min-width: 28px;
        text-align: center;
        border: 1px solid #ddd;
    }

    .size-available {
        background: #1a1a1a;
        color: #fff;
        border-color: #1a1a1a;
    }

    .size-unavailable {
        background: #fff;
        color: #999;
        border-color: #ddd;
    }

    .size-hidden-count {
        font-size: 11px;
        color: #999;
        margin-left: 4px;
    }

    /* ---------- СТАТУС ---------- */
    .status-badge {
        font-size: 12px;
        font-weight: 500;
        padding: 2px 14px;
        border-radius: 50px;
        display: inline-block;
    }

    .status-active {
        background: #e8f5e9;
        color: #2e7d32;
    }

    .status-inactive {
        background: #f5f5f5;
        color: #999;
    }

    .badge-discount {
        font-size: 10px;
        background: #1a1a1a;
        color: #fff;
        padding: 1px 8px;
        border-radius: 50px;
        margin-left: 4px;
    }

    /* ---------- ОСТАТКИ ---------- */
    .stock-badge {
        font-size: 12px;
        font-weight: 500;
        padding: 2px 12px;
        border-radius: 50px;
        display: inline-block;
        white-space: nowrap;
    }

    .stock-in-stock {
        background: #e8f5e9;
        color: #2e7d32;
    }

    .stock-low {
        background: #fff3e0;
        color: #e65100;
    }

    .stock-out {
        background: #fbe9e7;
        color: #c62828;
    }

    /* ---------- КНОПКИ ДЕЙСТВИЙ ---------- */
    .btn-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 30px;
        height: 30px;
        border: none;
        background: none;
        color: #999;
        font-size: 14px;
        cursor: pointer;
        border-radius: 0;
        transition: all 0.2s ease;
        text-decoration: none;
        font-weight: 400;
        padding: 0;
    }

        .btn-action:hover {
            color: #1a1a1a;
            background: #f0eeeb;
        }

        .btn-action.text-danger:hover {
            color: #dc3545;
            background: #fbe9e7;
        }

        .btn-action:disabled {
            opacity: 0.4;
            cursor: not-allowed;
        }

    .btn-dark {
        background-color: #1a1a1a;
        border: none;
        font-weight: 500;
        font-size: 13px;
        padding: 8px 20px;
        transition: background 0.2s;
        border-radius: 50px;
        color: #fff;
        text-decoration: none;
        display: inline-block;
    }

        .btn-dark:hover {
            background-color: #333;
            color: #fff;
        }

    /* ---------- СООБЩЕНИЯ ---------- */
    .alert-success-custom,
    .alert-danger-custom {
        padding: 12px 20px;
        border-radius: 0;
        border: none;
        font-size: 14px;
        margin-bottom: 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .alert-success-custom {
        background: #e8f5e9;
        color: #2e7d32;
    }

    .alert-danger-custom {
        background: #fbe9e7;
        color: #c62828;
    }

    /* ================================================================
           TAIGI — ПОИСК В АДМИНКЕ
           ================================================================ */

    .admin-search-bar {
        background: #fff;
        border: 1px solid #e8e7e4;
        padding: 20px 24px;
    }

    .admin-search-form {
        display: flex;
        gap: 10px;
        align-items: center;
        flex-wrap: wrap;
    }

    .admin-search-wrapper {
        position: relative;
        flex: 1;
        min-width: 240px;
    }

    .admin-search-icon {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: #999;
        font-size: 16px;
        pointer-events: none;
    }

    .admin-search-input {
        width: 100%;
        padding: 12px 40px 12px 42px;
        font-size: 14px;
        color: #1a1a1a;
        background: #fff;
        border: 1px solid #e0dedb;
        border-radius: 0;
        outline: none;
        transition: border-color 0.2s;
    }

        .admin-search-input:focus {
            border-color: #1a1a1a;
        }

        .admin-search-input::placeholder {
            color: #bbb;
        }

    .admin-search-clear {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: #999;
        text-decoration: none;
        font-size: 18px;
        line-height: 1;
        transition: color 0.2s;
    }

        .admin-search-clear:hover {
            color: #1a1a1a;
        }

    .admin-search-btn {
        padding: 12px 28px;
        background: #1a1a1a;
        color: #fff;
        font-size: 14px;
        font-weight: 500;
        letter-spacing: 0.5px;
        border: 1px solid #1a1a1a;
        border-radius: 0;
        cursor: pointer;
        transition: all 0.2s;
    }

        .admin-search-btn:hover {
            background: #333;
            border-color: #333;
        }

    .admin-search-result {
        font-size: 13px;
        color: #666;
        margin: 12px 0 0;
    }

    /* ================================================================
           TAIGI — ПАГИНАЦИЯ В АДМИНКЕ
           ================================================================ */

    .admin-pagination {
        margin-top: 24px;
        padding: 20px 24px;
        background: #fff;
        border: 1px solid #e8e7e4;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
    }

    .admin-pagination-info {
        font-size: 13px;
        color: #666;
    }

    .admin-pagination-nav {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
    }

    .admin-page-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 38px;
        height: 38px;
        padding: 0 12px;
        background: #fff;
        color: #1a1a1a;
        font-size: 13px;
        font-weight: 500;
        text-decoration: none;
        border: 1px solid #e0dedb;
        border-radius: 0;
        transition: all 0.2s;
        cursor: pointer;
    }

        .admin-page-btn:hover:not(.admin-page-btn-disabled):not(.admin-page-btn-active) {
            background: #f5f4f0;
            border-color: #1a1a1a;
        }

    .admin-page-btn-active {
        background: #1a1a1a;
        color: #fff;
        border-color: #1a1a1a;
        cursor: default;
    }

    .admin-page-btn-disabled {
        background: #f8f7f5;
        color: #bbb;
        cursor: not-allowed;
    }

    .admin-page-dots {
        display: inline-flex;
        align-items: center;
        padding: 0 4px;
        color: #999;
        font-size: 13px;
    }

    /* ================================================================
           АДАПТИВ
           ================================================================ */

    @@media (max-width: 768px) {
        .table-admin {
            font-size: 12px;
        }

            .table-admin thead th,
            .table-admin tbody td {
                padding: 6px 8px;
            }

        .product-thumb {
            width: 32px;
            height: 32px;
        }

        .btn-action {
            width: 26px;
            height: 26px;
            font-size: 12px;
        }

        .size-badge {
            font-size: 9px;
            padding: 1px 6px;
            min-width: 22px;
        }

        .page-title {
            font-size: 18px;
        }

        .btn-dark {
            font-size: 11px;
            padding: 6px 14px;
        }

        .stock-badge {
            font-size: 10px;
            padding: 1px 8px;
        }
        /* Поиск на мобильных */
        .admin-search-bar {
            padding: 16px 18px;
        }

        .admin-search-form {
            flex-direction: column;
            align-items: stretch;
        }

        .admin-search-btn {
            width: 100%;
        }
        /* Пагинация на мобильных */
        .admin-pagination {
            flex-direction: column;
            align-items: stretch;
            text-align: center;
            padding: 16px 18px;
        }

        .admin-pagination-nav {
            justify-content: center;
        }

        .admin-page-btn {
            min-width: 34px;
            height: 34px;
            font-size: 12px;
            padding: 0 8px;
        }
    }

    @@media (max-width: 576px) {
        .table-admin thead th {
            font-size: 9px;
            padding: 4px 6px;
        }

        .table-admin tbody td {
            font-size: 11px;
            padding: 4px 6px;
        }

        .product-thumb {
            width: 28px;
            height: 28px;
        }

        .btn-action {
            width: 22px;
            height: 22px;
            font-size: 10px;
        }

        .status-badge {
            font-size: 9px;
            padding: 1px 8px;
        }

        .size-badge {
            font-size: 8px;
            padding: 1px 4px;
            min-width: 18px;
        }

        .page-title {
            font-size: 16px;
        }

        .stock-badge {
            font-size: 9px;
            padding: 1px 6px;
        }
        /* Поиск */
        .admin-search-input {
            font-size: 13px;
            padding: 10px 36px 10px 38px;
        }

        .admin-search-icon {
            left: 12px;
            font-size: 14px;
        }
        /* Пагинация */
        .admin-page-btn {
            min-width: 30px;
            height: 30px;
            font-size: 11px;
            padding: 0 6px;
        }

        .admin-pagination-info {
            font-size: 12px;
        }
    }
</style>