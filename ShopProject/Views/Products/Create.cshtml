@model ShopProject.Models.ProductEditViewModel

@{
    ViewData["Title"] = "Добавить товар";
}

<div class="container py-4" style="max-width: 800px;">
    <h2 class="page-title">Добавить товар</h2>
    <hr class="page-divider" />

    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="row g-4">
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="Name" class="form-label">Название</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="form-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Article" class="form-label">Артикул</label>
                    <input asp-for="Article" class="form-control" placeholder="OWNB01108C002" />
                    <span asp-validation-for="Article" class="form-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Description" class="form-label">Описание</label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Description" class="form-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="CategoryId" class="form-label">Категория</label>
                    <select asp-for="CategoryId" class="form-control" asp-items="ViewBag.CategoryId">
                        <option value="">Выберите категорию</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="form-error"></span>
                </div>

                <div class="form-group form-check-group">
                    <input asp-for="HasSizes" class="form-check-input" />
                    <label asp-for="HasSizes" class="form-check-label">У товара есть размеры</label>
                    <span class="form-hint">Если отключить, товар будет добавляться в корзину без выбора размера</span>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="Price" class="form-label">Цена</label>
                    <input asp-for="Price" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="Price" class="form-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="OldPrice" class="form-label">Старая цена (скидка)</label>
                    <input asp-for="OldPrice" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="OldPrice" class="form-error"></span>
                    <span class="form-hint">Если указана, будет отображаться перечёркнутой</span>
                </div>

                <div class="form-group">
                    <label asp-for="Color" class="form-label">Цвет</label>
                    <input asp-for="Color" class="form-control" placeholder="пыльно-коричневый" />
                    <span asp-validation-for="Color" class="form-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Material" class="form-label">Материал</label>
                    <input asp-for="Material" class="form-control" placeholder="100% хлопок" />
                    <span asp-validation-for="Material" class="form-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Country" class="form-label">Страна производства</label>
                    <input asp-for="Country" class="form-control" placeholder="Россия" />
                    <span asp-validation-for="Country" class="form-error"></span>
                </div>
            </div>
        </div>

        <hr class="section-divider" />

        <h5 class="section-title">Изображения</h5>

        <div class="form-group">
            <label class="form-label">Загрузить файлы</label>
            <input type="file" name="NewImageFiles" class="form-control" multiple accept="image/*" />
            <span class="form-hint">Можно выбрать несколько файлов (jpg, png, gif)</span>
        </div>

        <div class="form-group mt-3">
            <label class="form-label">Или добавить URL-адреса</label>
            <div id="url-container">
                <div class="url-input-group">
                    <input type="text" name="NewImageUrls" class="form-control" placeholder="https://example.com/image.jpg" />
                </div>
            </div>
            <button type="button" class="btn-add-url" onclick="addUrlField()">+ Добавить ещё URL</button>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-dark rounded-pill px-5">Создать</button>
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Отмена</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function addUrlField() {
            const container = document.getElementById('url-container');
            const newField = document.createElement('div');
            newField.className = 'url-input-group mt-2';
            newField.innerHTML = `
                        <input type="text" name="NewImageUrls" class="form-control" placeholder="https://example.com/image.jpg" />
                    `;
            container.appendChild(newField);
        }
    </script>
}

<style>
    .page-title {
        font-size: 24px;
        font-weight: 700;
        color: #1a1a1a;
        letter-spacing: 0.5px;
    }

    .page-divider,
    .section-divider {
        border-color: #e8e7e4;
        margin: 12px 0 24px;
    }

    .section-title {
        font-size: 16px;
        font-weight: 600;
        color: #1a1a1a;
        margin-bottom: 16px;
    }

    .form-group {
        margin-bottom: 16px;
    }

    .form-label {
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: #555;
        text-transform: uppercase;
        letter-spacing: 0.3px;
        margin-bottom: 4px;
    }

    .form-control {
        width: 100%;
        padding: 10px 14px;
        border: 1px solid #ddd;
        border-radius: 0;
        font-size: 14px;
        background: #fff;
        transition: border-color 0.2s ease;
    }

        .form-control:focus {
            border-color: #1a1a1a;
            outline: none;
            box-shadow: none;
        }

        .form-control[type="file"] {
            padding: 8px 12px;
            border: 1px dashed #ddd;
            background: #fafafa;
            cursor: pointer;
        }

            .form-control[type="file"]:hover {
                border-color: #1a1a1a;
                background: #f5f5f5;
            }

    textarea.form-control {
        resize: vertical;
        min-height: 80px;
    }

    .form-error {
        display: block;
        font-size: 13px;
        color: #dc3545;
        margin-top: 2px;
    }

    .form-hint {
        display: block;
        font-size: 12px;
        color: #999;
        margin-top: 2px;
    }

    .form-check-group {
        display: flex;
        flex-direction: column;
        gap: 2px;
        margin-top: 8px;
    }

    .form-check-input {
        width: 18px;
        height: 18px;
        accent-color: #1a1a1a;
        margin-right: 8px;
    }

    .form-check-label {
        font-size: 14px;
        font-weight: 500;
        color: #1a1a1a;
    }

    .validation-summary {
        padding: 12px 16px;
        background: #fbe9e7;
        color: #c62828;
        font-size: 14px;
        margin-bottom: 16px;
        border-left: 3px solid #c62828;
    }

        .validation-summary ul {
            margin: 0;
            padding-left: 20px;
        }

    .url-input-group {
        margin-top: 8px;
    }

        .url-input-group:first-child {
            margin-top: 0;
        }

    .btn-add-url {
        margin-top: 8px;
        background: none;
        border: none;
        color: #999;
        font-size: 13px;
        cursor: pointer;
        padding: 4px 0;
        transition: color 0.2s;
    }

        .btn-add-url:hover {
            color: #1a1a1a;
        }

    .form-actions {
        display: flex;
        gap: 12px;
        margin-top: 24px;
        padding-top: 20px;
        border-top: 1px solid #f0eeeb;
    }

    .btn-dark {
        background-color: #1a1a1a;
        border: none;
        font-weight: 500;
        font-size: 14px;
        padding: 10px 32px;
        transition: background 0.2s;
        border-radius: 50px;
        color: #fff;
        text-decoration: none;
        display: inline-block;
        cursor: pointer;
    }

        .btn-dark:hover {
            background-color: #333;
            color: #fff;
        }

    .btn-outline-secondary {
        border: 1px solid #ddd;
        color: #999;
        background: transparent;
        font-weight: 500;
        font-size: 14px;
        padding: 10px 24px;
        transition: all 0.2s;
        border-radius: 50px;
        text-decoration: none;
        display: inline-block;
        cursor: pointer;
    }

        .btn-outline-secondary:hover {
            border-color: #1a1a1a;
            color: #1a1a1a;
        }

    @@media (max-width: 768px) {
        .form-actions {
            flex-direction: column;
        }

            .form-actions .btn {
                width: 100%;
                text-align: center;
                justify-content: center;
            }

        .page-title {
            font-size: 20px;
        }
    }

    @@media (max-width: 576px) {
        .page-title {
            font-size: 18px;
        }

        .form-label {
            font-size: 12px;
        }

        .form-control {
            font-size: 13px;
            padding: 8px 12px;
        }

        .btn-dark,
        .btn-outline-secondary {
            font-size: 13px;
            padding: 8px 16px;
        }
    }
</style>