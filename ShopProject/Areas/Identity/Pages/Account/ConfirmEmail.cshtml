@page
@model ConfirmEmailModel
@{
    ViewData["Title"] = "Email подтверждён";
}

@{
    var isAuthenticated = User.Identity.IsAuthenticated;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="text-center">
                <div class="success-icon">
                    <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="#1a1a1a" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                        <polyline points="22 4 12 14.01 9 11.01" />
                    </svg>
                </div>

                <h2 class="mt-3">Email подтверждён</h2>
                <p class="text-muted">
                    Ваш email успешно подтверждён.
                    @if (!isAuthenticated)
                    {
                        <span>Теперь вы можете войти в свой аккаунт.</span>
                    }
                    else
                    {
                        <span>Все возможности аккаунта теперь доступны.</span>
                    }
                </p>

                <div class="mt-4">
                    @if (!isAuthenticated)
                    {
                        <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-dark btn-lg rounded-pill px-5">
                            Войти
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Home" asp-action="Index" class="btn btn-dark btn-lg rounded-pill px-5">
                            На главную
                        </a>
                    }
                </div>

                <div class="mt-3">
                    @if (!isAuthenticated)
                    {
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                            На главную
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .success-icon {
        display: inline-block;
        line-height: 1;
        color: #1a1a1a;
    }

        .success-icon svg {
            display: block;
            stroke: #1a1a1a;
        }

    .btn-dark {
        background-color: #1a1a1a;
        border: none;
        border-radius: 50px !important;
        font-weight: 600;
        font-size: 15px;
        padding: 12px 40px;
        transition: background 0.2s;
        color: #fff;
        text-decoration: none;
        display: inline-block;
        cursor: pointer;
    }

        .btn-dark:hover {
            background-color: #333;
            color: #fff;
        }

    .btn-outline-secondary {
        border: 1px solid #ddd;
        color: #999;
        background: transparent;
        font-weight: 500;
        font-size: 14px;
        padding: 10px 28px;
        transition: all 0.2s;
        border-radius: 50px !important;
        text-decoration: none;
        display: inline-block;
        cursor: pointer;
    }

        .btn-outline-secondary:hover {
            border-color: #1a1a1a;
            color: #1a1a1a;
        }

    .text-muted {
        color: #999 !important;
        font-size: 16px;
    }

    @@media (max-width: 576px) {
        .success-icon svg {
            width: 60px;
            height: 60px;
        }

        h2 {
            font-size: 22px;
        }

        .text-muted {
            font-size: 14px;
        }

        .btn-dark {
            font-size: 14px;
            padding: 10px 28px;
        }

        .btn-outline-secondary {
            font-size: 13px;
            padding: 8px 20px;
        }
    }
</style>