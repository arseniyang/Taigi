@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Доступ запрещён";
}

<div class="empty-state">
    <div class="empty-state-content">
        <div class="empty-state-icon">
            <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="#dc3545" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10" />
                <line x1="15" y1="9" x2="9" y2="15" />
                <line x1="9" y1="9" x2="15" y2="15" />
            </svg>
        </div>
        <h3 class="empty-state-title">Доступ запрещён</h3>
        <p class="empty-state-text">
            У вас нет прав для просмотра этой страницы.<br />
            Обратитесь к администратору, если считаете, что это ошибка.
        </p>
        <div class="empty-state-actions">
            <a asp-controller="Home" asp-action="Index" class="empty-state-btn">
                На главную
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12" />
                    <polyline points="12 5 19 12 12 19" />
                </svg>
            </a>
        </div>
    </div>
</div>

<style>
    .empty-state {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 60vh;
        padding: 20px;
    }

    .empty-state-content {
        text-align: center;
        max-width: 480px;
    }

    .empty-state-icon {
        display: inline-block;
        margin-bottom: 20px;
        line-height: 1;
    }

        .empty-state-icon svg {
            display: block;
        }

    .empty-state-title {
        font-size: 24px;
        font-weight: 700;
        color: #1a1a1a;
        margin-bottom: 10px;
    }

    .empty-state-text {
        font-size: 15px;
        color: #999;
        line-height: 1.6;
        margin-bottom: 28px;
    }

    .empty-state-actions {
        display: flex;
        flex-direction: column;
        gap: 10px;
        align-items: center;
    }

    .empty-state-btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: #1a1a1a;
        color: #fff;
        border: none;
        padding: 12px 32px;
        font-size: 14px;
        font-weight: 600;
        letter-spacing: 0.5px;
        cursor: pointer;
        transition: background 0.25s ease;
        text-decoration: none;
        border-radius: 50px;
    }

        .empty-state-btn:hover {
            background: #333;
            color: #fff;
            text-decoration: none;
        }

        .empty-state-btn svg {
            transition: transform 0.25s ease;
        }

        .empty-state-btn:hover svg {
            transform: translateX(4px);
        }

    @@media (max-width: 576px) {
        .empty-state {
            min-height: 50vh;
        }

        .empty-state-title {
            font-size: 20px;
        }

        .empty-state-text {
            font-size: 14px;
        }

        .empty-state-btn {
            font-size: 13px;
            padding: 10px 24px;
        }

        .empty-state-icon svg {
            width: 60px;
            height: 60px;
        }
    }
</style>