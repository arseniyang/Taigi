@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Восстановление пароля";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="text-center mb-4">
                <h2 class="page-title">Восстановление пароля</h2>
                <p class="text-muted">
                    Введите email, указанный при регистрации.<br />
                    Мы отправим ссылку для сброса пароля.
                </p>
            </div>

            <div class="card">
                <div class="card-body">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>

                        <div class="form-group">
                            <label asp-for="Input.Email" class="form-label">Email</label>
                            <input asp-for="Input.Email" class="form-control" autocomplete="email" placeholder="example@mail.ru" />
                            <span asp-validation-for="Input.Email" class="form-error"></span>
                        </div>

                        <div class="form-actions mt-4">
                            <button type="submit" class="btn btn-dark btn-lg w-100 rounded-pill py-3">
                                Отправить ссылку
                            </button>
                        </div>
                    </form>

                    <div class="text-center mt-3">
                        <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-secondary rounded-pill px-4">
                            Вернуться ко входу
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
    .page-title {
        font-size: 26px;
        font-weight: 700;
        color: #1a1a1a;
        letter-spacing: 0.5px;
        margin-bottom: 8px;
    }

    .text-muted {
        color: #999 !important;
        font-size: 15px;
    }

    .card {
        border: 1px solid #e8e7e4;
        border-radius: 0;
        background: #fff;
    }

    .card-body {
        padding: 32px 28px;
    }

    .form-group {
        margin-bottom: 16px;
    }

    .form-label {
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: #555;
        text-transform: uppercase;
        letter-spacing: 0.3px;
        margin-bottom: 4px;
    }

    .form-control {
        width: 100%;
        padding: 12px 16px;
        border: 1px solid #ddd;
        border-radius: 0;
        font-size: 15px;
        background: #fff;
        transition: border-color 0.2s ease;
    }

        .form-control:focus {
            border-color: #1a1a1a;
            outline: none;
            box-shadow: none;
        }

    .form-error {
        display: block;
        font-size: 13px;
        color: #dc3545;
        margin-top: 2px;
    }

    .validation-summary {
        padding: 12px 16px;
        background: #fbe9e7;
        color: #c62828;
        font-size: 14px;
        margin-bottom: 16px;
        border-left: 3px solid #c62828;
    }

        .validation-summary ul {
            margin: 0;
            padding-left: 20px;
        }

    .btn-dark {
        background-color: #1a1a1a;
        border: none;
        border-radius: 50px !important;
        font-weight: 600;
        font-size: 16px;
        padding: 14px 0;
        transition: background 0.2s;
        color: #fff;
        text-decoration: none;
        display: inline-block;
        cursor: pointer;
        text-align: center;
    }

        .btn-dark:hover {
            background-color: #333;
            color: #fff;
        }

    .btn-outline-secondary {
        border: 1px solid #ddd;
        color: #999;
        background: transparent;
        font-weight: 500;
        font-size: 14px;
        padding: 10px 24px;
        transition: all 0.2s;
        border-radius: 50px !important;
        text-decoration: none;
        display: inline-block;
        cursor: pointer;
        text-align: center;
    }

        .btn-outline-secondary:hover {
            border-color: #1a1a1a;
            color: #1a1a1a;
        }

    @@media (max-width: 576px) {
        .page-title {
            font-size: 20px;
        }

        .card-body {
            padding: 20px 16px;
        }

        .form-control {
            font-size: 14px;
            padding: 10px 14px;
        }

        .btn-dark {
            font-size: 14px;
            padding: 12px 0;
        }

        .text-muted {
            font-size: 14px;
        }
    }
</style>