@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Ссылка отправлена";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="text-center">
                <div class="success-icon">
                    <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="#1a1a1a" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                        <polyline points="22 4 12 14.01 9 11.01" />
                    </svg>
                </div>

                <h2 class="mt-3">Ссылка отправлена</h2>
                <p class="text-muted">
                    На ваш email отправлена ссылка для сброса пароля.<br />
                    Перейдите по ней, чтобы установить новый пароль.
                </p>

                <p class="text-muted small mt-3">
                    Если письмо не пришло, проверьте папку "Спам".<br />
                    Ссылка действительна в течение 24 часов.
                </p>

                <div class="mt-4">
                    <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-dark rounded-pill px-5">
                        Вернуться ко входу
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .success-icon {
        display: inline-block;
        line-height: 1;
        color: #1a1a1a;
    }

        .success-icon svg {
            display: block;
            stroke: #1a1a1a;
        }

    .text-muted {
        color: #999 !important;
        font-size: 16px;
    }

    .btn-dark {
        background-color: #1a1a1a;
        border: none;
        border-radius: 50px !important;
        font-weight: 600;
        font-size: 15px;
        padding: 12px 40px;
        transition: background 0.2s;
        color: #fff;
        text-decoration: none;
        display: inline-block;
        cursor: pointer;
    }

        .btn-dark:hover {
            background-color: #333;
            color: #fff;
        }

    @@media (max-width: 576px) {
        .success-icon svg {
            width: 60px;
            height: 60px;
        }

        h2 {
            font-size: 22px;
        }

        .text-muted {
            font-size: 14px;
        }

        .btn-dark {
            font-size: 14px;
            padding: 10px 28px;
        }
    }
</style>