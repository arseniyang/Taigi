@page
@model RegisterSuccessModel
@{
    ViewData["Title"] = "Регистрация завершена";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="text-center">
                <div class="success-icon">
                    <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="#1a1a1a" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                        <polyline points="22 4 12 14.01 9 11.01" />
                    </svg>
                </div>

                <h2 class="mt-3">Регистрация завершена</h2>

                <p class="text-muted">
                    На ваш email <strong>@Model.Email</strong> отправлена ссылка для подтверждения.
                </p>

                <div class="alert alert-info mt-3" style="border-radius:0; border-left: 3px solid #1a1a1a; background: #f8f7f5; text-align:left;">
                    <p class="mb-1">
                        <strong>Для оформления заказов необходимо подтвердить email.</strong>
                    </p>
                    <p class="mb-0 text-muted small">
                        Перейдите по ссылке в письме, чтобы активировать все возможности аккаунта.
                    </p>
                </div>

                <div class="mt-4">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-dark rounded-pill px-5">
                        На главную
                    </a>
                </div>

                <div class="mt-3">
                    <form asp-page-handler="Resend" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="email" value="@Model.Email" />
                        <button type="submit" class="btn btn-link text-muted small text-decoration-none">
                            Отправить повторно
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .success-icon {
        display: inline-block;
        line-height: 1;
        color: #1a1a1a;
    }

        .success-icon svg {
            display: block;
            stroke: #1a1a1a;
        }

    .alert-info {
        border-radius: 0;
        border: 1px solid #e8e7e4;
        border-left: 3px solid #1a1a1a;
        background: #f8f7f5;
        padding: 16px 20px;
    }

    .btn-dark {
        background-color: #1a1a1a;
        border: none;
        border-radius: 50px !important;
        font-weight: 600;
        font-size: 15px;
        padding: 12px 40px;
        transition: background 0.2s;
        color: #fff;
        text-decoration: none;
        display: inline-block;
        cursor: pointer;
    }

        .btn-dark:hover {
            background-color: #333;
            color: #fff;
        }

    .btn-link {
        color: #999;
        text-decoration: none;
    }

        .btn-link:hover {
            color: #1a1a1a;
        }

    .text-muted {
        color: #999 !important;
        font-size: 15px;
    }

    @@media (max-width: 576px) {
        .success-icon svg {
            width: 60px;
            height: 60px;
        }

        h2 {
            font-size: 22px;
        }

        .text-muted {
            font-size: 14px;
        }

        .btn-dark {
            font-size: 14px;
            padding: 10px 28px;
        }
    }
</style>