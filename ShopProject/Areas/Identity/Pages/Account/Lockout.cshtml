@page
@model LockoutModel
@{
    ViewData["Title"] = "Аккаунт заблокирован";
}

<div class="empty-state">
    <div class="empty-state-content">
        <div class="empty-state-icon">
            <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="#dc3545" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                <circle cx="12" cy="16" r="1.5" fill="#dc3545" stroke="#dc3545" />
            </svg>
        </div>
        <h3 class="empty-state-title">Аккаунт заблокирован</h3>
        <p class="empty-state-text">
            Вы превысили допустимое количество попыток входа.<br />
            Попробуйте снова через <strong>15 минут</strong>.
        </p>
        <div class="empty-state-actions">
            <a asp-controller="Home" asp-action="Index" class="empty-state-btn">
                На главную
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12" />
                    <polyline points="12 5 19 12 12 19" />
                </svg>
            </a>
            <a asp-area="Identity" asp-page="/Account/ForgotPassword" class="empty-state-link">
                Забыли пароль?
            </a>
        </div>
    </div>
</div>

<style>
    .empty-state {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 60vh;
        padding: 20px;
    }

    .empty-state-content {
        text-align: center;
        max-width: 480px;
    }

    .empty-state-icon {
        display: inline-block;
        margin-bottom: 20px;
        line-height: 1;
    }

        .empty-state-icon svg {
            display: block;
        }

    .empty-state-title {
        font-size: 24px;
        font-weight: 700;
        color: #1a1a1a;
        margin-bottom: 10px;
    }

    .empty-state-text {
        font-size: 15px;
        color: #999;
        line-height: 1.6;
        margin-bottom: 28px;
    }

        .empty-state-text strong {
            color: #1a1a1a;
            font-weight: 600;
        }

    .empty-state-actions {
        display: flex;
        flex-direction: column;
        gap: 12px;
        align-items: center;
    }

    .empty-state-btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: #1a1a1a;
        color: #fff;
        border: none;
        padding: 12px 32px;
        font-size: 14px;
        font-weight: 600;
        letter-spacing: 0.5px;
        cursor: pointer;
        transition: background 0.25s ease;
        text-decoration: none;
        border-radius: 50px;
    }

        .empty-state-btn:hover {
            background: #333;
            color: #fff;
            text-decoration: none;
        }

        .empty-state-btn svg {
            transition: transform 0.25s ease;
        }

        .empty-state-btn:hover svg {
            transform: translateX(4px);
        }

    .empty-state-link {
        color: #999;
        font-size: 14px;
        text-decoration: none;
        transition: color 0.2s;
        border-bottom: 1px solid transparent;
    }

        .empty-state-link:hover {
            color: #1a1a1a;
            border-bottom-color: #1a1a1a;
        }

    @@media (max-width: 576px) {
        .empty-state {
            min-height: 50vh;
        }

        .empty-state-title {
            font-size: 20px;
        }

        .empty-state-text {
            font-size: 14px;
        }

        .empty-state-btn {
            font-size: 13px;
            padding: 10px 24px;
        }

        .empty-state-icon svg {
            width: 60px;
            height: 60px;
        }
    }
</style>